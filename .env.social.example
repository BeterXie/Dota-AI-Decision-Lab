# Social login is opt-in. Copy this file to .env.social for local development.
# Never commit real provider secrets.
#
# Keep DOTA_AUTH_* settings in .env.social (or inject them as process environment
# variables). Do not mix them into the core .env: app.config.Settings validates the
# core file strictly and rejects unrelated keys.

# Local browser-visible origin. Vite runs on 127.0.0.1:5173 and proxies /api
# to the backend during local development.
DOTA_AUTH_EXTERNAL_BASE_URL=http://127.0.0.1:5173

# Google OAuth / OpenID Connect
# Local authorized redirect URI:
# http://127.0.0.1:5173/api/auth/google/callback
DOTA_AUTH_GOOGLE_ENABLED=false
DOTA_AUTH_GOOGLE_CLIENT_ID=
DOTA_AUTH_GOOGLE_CLIENT_SECRET=

# Steam OpenID authentication does not require a Steam Web API key.
# Enable after the external base URL is correct for the environment.
DOTA_AUTH_STEAM_ENABLED=false

# Production DotaScope values (enable only after HTTPS is live and provider
# consoles have the exact callbacks configured):
# DOTA_AUTH_EXTERNAL_BASE_URL=https://dotascope.com
# Google redirect URI: https://dotascope.com/api/auth/google/callback
# Steam realm:        https://dotascope.com/
# Steam return URL:   https://dotascope.com/api/auth/steam/callback
#
# Once runtime settings have been seeded into PostgreSQL, the Runtime Admin
# control plane value auth.external_base_url becomes authoritative. Verify it is
# https://dotascope.com before enabling Google or Steam in production.
