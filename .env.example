DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/dota_ai_decision_lab

# Provider endpoints remain configurable and are never embedded in domain code.
# RAYBET_INFO_BASE_URLS is the primary list (comma separated, failover order).
# RAYBET_INFO_BASE_URL (singular) is kept as a legacy fallback when the list is empty.
RAYBET_INFO_BASE_URLS=https://cfinfo.365raylinks.com/v2,https://iminfo.esportsworldlink.com/v2,https://cfinfo.365raylines.com/v2
RAYBET_SOCKET_URL=wss://cfsocket.365raylinks.com/socketcluster/
RAYBET_ORIGIN=https://www.ray086.com
DLTV_BASE_URL=https://dltv.org
STRATZ_GRAPHQL_URL=https://api.stratz.com/graphql
OPENDOTA_BASE_URL=https://api.opendota.com/api
HISTORICAL_SYNC_BATCH_MAPS=20

STRATZ_TOKEN=
OPENDOTA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=high
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
# deepseek-flash only powers email translation by default; set true to let it vote too.
DEEPSEEK_FLASH_DECISIONS_ENABLED=false
EMAIL_TRANSLATION_REASONING_EFFORT=low
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5
# Set to false to keep the Kimi key configured but stop it from voting.
KIMI_DECISIONS_ENABLED=false
AI_TIMEOUT_SECONDS=50
AI_MIN_GAME_TIME_SECONDS=600
AI_CHECKPOINT_MINUTES=10,15,20,25,30,35,40,45,50,55,60
# DLTV broadcast data lagging the real-time market beyond this is excluded from AI input.
AI_MAX_LIVE_DATA_LAG_SECONDS=120

# One bilingual summary email is sent after all AI decisions for a snapshot are persisted.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_RECIPIENTS=analyst@example.com,owner@example.com
EMAIL_SUBJECT_PREFIX=[Dota AI Decision Lab]
RESEND_API_KEY=
RESEND_FROM=Dota AI Decision Lab <notifications@example.com>
RESEND_BASE_URL=https://api.resend.com
RESEND_TIMEOUT_SECONDS=30

# Provider workers are enabled by default. Set false for an API-only local run.
RUN_PROVIDER_WORKERS=true
AUTO_MIGRATE=true
HOST=127.0.0.1
# Required when HOST is a non-loopback address; the runtime refuses to start
# otherwise (the dashboard API has no auth layer, CORS is not a boundary).
# API_TOKEN=
PORT=8000
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
