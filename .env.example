DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/dota_ai_decision_lab

# Provider endpoints remain configurable and are never embedded in domain code.
RAYBET_INFO_BASE_URL=https://iminfo.esportsworldlink.com/v2
RAYBET_SOCKET_URL=wss://cfsocket.365raylinks.com/socketcluster/
RAYBET_ORIGIN=https://www.ray086.com
DLTV_BASE_URL=https://dltv.org
STRATZ_GRAPHQL_URL=https://api.stratz.com/graphql
OPENDOTA_BASE_URL=https://api.opendota.com/api
HISTORICAL_SYNC_BATCH_MAPS=20

STRATZ_TOKEN=
OPENDOTA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5
AI_TIMEOUT_SECONDS=120

# Provider workers are enabled by default. Set false for an API-only local run.
RUN_PROVIDER_WORKERS=true
AUTO_MIGRATE=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
