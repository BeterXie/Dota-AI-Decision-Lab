DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/dota_ai_decision_lab

# Provider endpoints remain configurable and are never embedded in domain code.
# RAYBET_INFO_BASE_URLS is the primary list (comma separated, failover order).
# RAYBET_INFO_BASE_URL (singular) is kept as a legacy fallback when the list is empty.
RAYBET_INFO_BASE_URLS=https://cfinfo.365raylinks.com/v2,https://iminfo.esportsworldlink.com/v2,https://cfinfo.365raylines.com/v2
RAYBET_SOCKET_URL=wss://cfsocket.365raylinks.com/socketcluster/
RAYBET_ORIGIN=https://www.ray086.com
DLTV_BASE_URL=https://dltv.org
STRATZ_GRAPHQL_URL=https://api.stratz.com/graphql
OPENDOTA_BASE_URL=https://api.opendota.com/api
HISTORICAL_SYNC_BATCH_MAPS=20

STRATZ_TOKEN=
OPENDOTA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=high
# Optional local OpenAI-compatible proxy; registered as an independent GPT voter.
# Set LOCAL_OPENAI_API_KEY to enable it. Some local proxies accept any bearer key.
LOCAL_OPENAI_API_KEY=
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_MODEL=local-model
LOCAL_OPENAI_REASONING_EFFORT=high
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
# deepseek-flash only powers email translation by default; set true to let it vote too.
DEEPSEEK_FLASH_DECISIONS_ENABLED=false
# deepseek-pro votes by default; set false to temporarily run only flash in decisions.
DEEPSEEK_PRO_DECISIONS_ENABLED=true
EMAIL_TRANSLATION_REASONING_EFFORT=low
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5
# Set to false to keep the Kimi key configured but stop it from voting.
KIMI_DECISIONS_ENABLED=false
AI_TIMEOUT_SECONDS=50
# One RUN_AI_PROVIDER job = one provider/model; this is concurrent AI HTTP count.
AI_WORKER_CONCURRENCY=4
AI_MIN_GAME_TIME_SECONDS=600
AI_CHECKPOINT_MINUTES=10,15,20,25,30,35,40,45,50,55,60
# DLTV broadcast data lagging the real-time market beyond this is excluded from AI input.
AI_MAX_LIVE_DATA_LAG_SECONDS=120
# Virtual shadow bankroll per provider/model per match; models choose stake within it.
AI_VIRTUAL_BANKROLL=10000
AI_PRIOR_DECISIONS_LIMIT=10

# One bilingual summary email is sent after all AI decisions for a snapshot are persisted.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_RECIPIENTS=analyst@example.com,owner@example.com
EMAIL_SUBJECT_PREFIX=[Dota AI Decision Lab]
RESEND_API_KEY=
RESEND_FROM=Dota AI Decision Lab <notifications@example.com>
RESEND_BASE_URL=https://api.resend.com
RESEND_TIMEOUT_SECONDS=30

# Passwordless email login. Reuses RESEND_API_KEY / RESEND_FROM above.
# Generate a private secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENABLED=false
AUTH_SECRET_KEY=
AUTH_LOGIN_CODE_TTL_SECONDS=600
AUTH_LOGIN_RESEND_COOLDOWN_SECONDS=60
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_SESSION_TTL_DAYS=30
# Keep false for the current loopback HTTP runtime; enable only behind HTTPS later.
AUTH_COOKIE_SECURE=false
AUTH_EMAIL_SUBJECT_PREFIX=[Dota AI Decision Lab]

# Paddle Billing. Keep disabled until the sandbox catalog and webhook destination
# are configured. Production billing requires AUTH_ENABLED=true.
PADDLE_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Optional approved/default Paddle checkout URL. Blank uses the account default payment link.
PADDLE_CHECKOUT_URL=
# Configure the two server-owned one-time, non-expiring catalog prices.
PADDLE_SERIES_PASS_PRICE_ID=
PADDLE_EVENT_PASS_PRICE_ID=
PADDLE_TIMEOUT_SECONDS=15
PADDLE_WEBHOOK_TOLERANCE_SECONDS=5

# Referral campaign. Disabled by default. A code claim does not grant Pro by
# itself: rewards are issued only after the invited account completes a verified
# paid Paddle purchase. Full refund/chargeback revokes that referral reward.
REFERRAL_ENABLED=false
REFERRAL_CAMPAIGN_KEY=referral-v1
REFERRAL_CLAIM_WINDOW_DAYS=7
REFERRAL_INVITER_REWARD_DAYS=7
REFERRAL_INVITED_REWARD_DAYS=3
REFERRAL_MAX_REWARDS_PER_INVITER=20

# Crypto/stablecoin billing is intentionally NOT enabled by a generic env switch.
# It will use a separate provider adapter and jurisdiction/entity review rather than
# bypassing the server-owned billing lifecycle or Paddle checkout mapping.

# Official WeChat ClawBot channel, connected directly via Tencent's iLink HTTP API.
# Enable, then run:  python -m tools.wechat_clawbot login   (scan with personal WeChat)
WECHAT_CLAWBOT_ENABLED=false
WECHAT_CLAWBOT_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_CLAWBOT_STATE_DIR=.runtime/wechat-clawbot
WECHAT_CLAWBOT_BOT_AGENT=Dota-AI-Decision-Lab/0.1.0
# Optional public contact/deep link for the WeChat bot. Users open this link
# before sending the per-user Notification Center pairing command.
WECHAT_CLAWBOT_CONTACT_URL=
WECHAT_CLAWBOT_TIMEOUT_SECONDS=15
WECHAT_CLAWBOT_LONG_POLL_TIMEOUT_SECONDS=40
# Never deliver a decision alert more than 10 minutes after its snapshot.
WECHAT_CLAWBOT_DECISION_MAX_AGE_SECONDS=600

# Official QQ Bot channel. The bridge loads the harness-installed
# @tencent-connect/qqbot-nodejs SDK; bind a robot once with:
#   python -m tools.qq_bot login
QQ_BOT_ENABLED=false
# Optional pre-bound credentials for non-interactive installs. QR login stores
# credentials under QQ_BOT_STATE_DIR and is preferred on developer machines.
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_STATE_DIR=.runtime/qq-bot
# Optional fallback public contact link. The running bridge normally creates
# an official per-user share link automatically.
QQ_BOT_CONTACT_URL=
# Blank = auto-detect ~/.dsh/profiles/qqbot/node_modules, then qqbot_bridge/node_modules.
QQ_BOT_SDK_ROOT=
QQ_BOT_BRIDGE_HOST=127.0.0.1
QQ_BOT_BRIDGE_PORT=18081
QQ_BOT_BRIDGE_TIMEOUT_SECONDS=15
QQ_BOT_BRIDGE_STARTUP_TIMEOUT_SECONDS=20
# Never deliver a decision alert more than 10 minutes after its snapshot.
QQ_BOT_DECISION_MAX_AGE_SECONDS=600
# Comma separated explicit push targets: c2c:<openid> or group:<group_openid>.
# Private-chat users pair through Notification Center; groups subscribe with
# the keyword 订阅通知.
QQ_BOT_DECISION_TARGETS=
# In groups only react when the bot is @mentioned.
QQ_BOT_GROUP_REQUIRE_MENTION=true
# Optional comma separated allowlists. Empty means all C2C users may query and
# all groups may query (still subject to QQ_BOT_GROUP_REQUIRE_MENTION). A
# one-time 绑定 <code> pairing command always reaches Python for verification.
QQ_BOT_ALLOWED_C2C=
QQ_BOT_ALLOWED_GROUPS=

# Provider workers are enabled by default. Set false for an API-only local run.
RUN_PROVIDER_WORKERS=true
AUTO_MIGRATE=true
# The dashboard remains loopback-only even when email authentication is enabled.
# Remote serving needs a separate TLS/origin/proxy hardening mode.
HOST=127.0.0.1
# API_TOKEN=
PORT=8000
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
